#!/usr/bin/env bash
# Runs spec/system against a throwaway Ubuntu container (spec/system/Dockerfile).
# Extra arguments go to rspec.
#
# Isolation: the image gets only the files in spec/system (COPY); nothing from this
# machine is mounted, no --privileged, no Docker socket, no keys. sshd is published on
# 127.0.0.1 only, on a port Docker picks. The container is removed on exit, success or not.
set -euo pipefail

cd "$(dirname "$0")/.."

if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
  echo "bin/system-spec: Docker is not available. spec/system runs only inside the test container;" >&2
  echo "install or start Docker and run again." >&2
  exit 1
fi

image=herd-system-spec
docker build -q -t "$image" spec/system >/dev/null

container=$(docker run -d --rm -p 127.0.0.1::22 "$image")
trap 'docker stop "$container" >/dev/null 2>&1 || true' EXIT

port=$(docker port "$container" 22/tcp | head -1 | sed 's/.*://')

# Ready once sshd sends its "SSH-2.0-..." banner on the published port.
ready=
for _ in $(seq 1 100); do
  if banner=$(exec 3<>"/dev/tcp/127.0.0.1/$port" && head -c 4 <&3) 2>/dev/null && [ "$banner" = "SSH-" ]; then
    ready=1
    break
  fi
  sleep 0.1
done
if [ -z "$ready" ]; then
  echo "bin/system-spec: sshd in the test container didn't start" >&2
  docker logs "$container" >&2 || true
  exit 1
fi

HERD_SYSTEM_HOST=127.0.0.1 HERD_SYSTEM_PORT="$port" \
  bundle exec rspec spec/system "$@"
